# Client-side Supabase connection. Safe to expose (anon key + RLS scope it).
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Note: GEMINI_API_KEY is NOT used client-side. It's set as a Supabase Edge
# Function secret (see supabase/functions/ai-call) and never reaches the browser.
